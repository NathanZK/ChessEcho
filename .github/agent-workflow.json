{
  "target_base": "main",
  "authoritative_remote": "github.com/NathanZK/ChessEcho",
  "workflow": {
    "format": "chess-echo-skill-workflow-config-v1",
    "run_root": ".agent-workflow/runs",
    "roles": {
      "planner": "chess-echo-planner",
      "reviewer": "chess-echo-reviewer",
      "test_implementer": "chess-echo-test-implementer",
      "implementer": "chess-echo-implementer"
    },
    "approval_mechanism": "self-attested-local-acknowledgment",
    "approvals": {
      "plan": "plan_approved",
      "tests": "tests_approved",
      "completed_run_reconciliation": "completed_run_reconciled",
      "pr": "I approve this draft PR."
    },
    "execution": {
      "default": {
        "timeout_ms": 30000,
        "grace_ms": 1000,
        "output_limit_bytes": 524288,
        "stderr_limit_bytes": 131072
      },
      "git": {
        "command": ["git"],
        "timeout_ms": 30000,
        "grace_ms": 1000,
        "output_limit_bytes": 524288
      },
      "github": {
        "command": ["gh"],
        "timeout_ms": 30000,
        "grace_ms": 1000,
        "output_limit_bytes": 524288
      },
      "validation": {
        "timeout_ms": 3600000,
        "grace_ms": 2000,
        "output_limit_bytes": 8388608,
        "stderr_limit_bytes": 1048576
      }
    }
  },
  "validation_profiles": {
    "backend": {
      "test_paths": ["src/test/**/*"],
      "checks": [
        {
          "name": "backend-lint",
          "command": ["./gradlew", "ktlintCheck"]
        },
        {
          "name": "backend-tests",
          "command": ["./gradlew", "test"]
        }
      ]
    },
    "frontend": {
      "test_paths": [
        "frontend/src/**/__tests__/**/*",
        "frontend/src/**/__mocks__/**/*",
        "frontend/src/**/*.test.*",
        "frontend/src/**/*.spec.*",
        "frontend/test/**/*",
        "frontend/tests/**/*",
        "frontend/vitest.config.mts",
        "frontend/vitest.setup.ts"
      ],
      "checks": [
        {
          "name": "frontend-lint",
          "command": ["npm", "run", "lint"],
          "cwd": "frontend"
        },
        {
          "name": "frontend-typecheck",
          "command": ["npx", "tsc", "--noEmit"],
          "cwd": "frontend"
        },
        {
          "name": "frontend-tests",
          "command": ["npm", "run", "test"],
          "cwd": "frontend"
        },
        {
          "name": "frontend-build",
          "command": ["npm", "run", "build"],
          "cwd": "frontend"
        }
      ]
    },
    "full-stack": {
      "test_paths": [
        "src/test/**/*",
        "frontend/src/**/__tests__/**/*",
        "frontend/src/**/__mocks__/**/*",
        "frontend/src/**/*.test.*",
        "frontend/src/**/*.spec.*",
        "frontend/test/**/*",
        "frontend/tests/**/*",
        "frontend/vitest.config.mts",
        "frontend/vitest.setup.ts"
      ],
      "checks": [
        {
          "name": "backend-lint",
          "command": ["./gradlew", "ktlintCheck"]
        },
        {
          "name": "backend-tests",
          "command": ["./gradlew", "test"]
        },
        {
          "name": "frontend-lint",
          "command": ["npm", "run", "lint"],
          "cwd": "frontend"
        },
        {
          "name": "frontend-typecheck",
          "command": ["npx", "tsc", "--noEmit"],
          "cwd": "frontend"
        },
        {
          "name": "frontend-tests",
          "command": ["npm", "run", "test"],
          "cwd": "frontend"
        },
        {
          "name": "frontend-build",
          "command": ["npm", "run", "build"],
          "cwd": "frontend"
        }
      ]
    },
    "workflow-tooling": {
      "test_paths": ["scripts/tests/**/*"],
      "checks": [
        {
          "name": "agent-workflow-tests",
          "command": ["make", "agent-workflow-test"],
          "cwd": "."
        }
      ]
    }
  }
}
